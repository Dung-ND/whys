---
// Starlight is one thin ray: moving air bends it this way and that, so the star dances and flickers.
// A planet is a tiny disc: many rays wobble independently and average out, so it shines steadily.
import Figure from '../Figure.astro';
interface Props { label: string; star: string; planet: string; air: string; twinkles: string; steady: string; you: string }
const { label, star, planet, air, twinkles, steady, you } = Astro.props;
---
<Figure label={label} width={640} height={340}>
  <rect width="640" height="340" rx="16" fill="var(--art-night)" />
  <!-- air layers -->
  <g class="air" fill="none" stroke="var(--art-sky)" stroke-width="3" stroke-linecap="round" stroke-dasharray="40 30" opacity="0.4">
    <path d="M-80 140q40 -14 80 0t80 0t80 0t80 0t80 0t80 0t80 0t80 0t80 0t80 0" />
    <path class="b" d="M-80 188q40 14 80 0t80 0t80 0t80 0t80 0t80 0t80 0t80 0t80 0t80 0" />
  </g>
  <text x="320" y="122" text-anchor="middle" class="t">{air}</text>
  <!-- star: one ray, wobbling -->
  <path d="M160 26l3 8l8 3l-8 3l-3 8l-3 -8l-8 -3l8 -3z" fill="var(--art-sun)" />
  <text x="160" y="72" text-anchor="middle" class="t">{star}</text>
  <path class="wob" d="M160 90L160 120L150 160L168 200L160 280" fill="none" stroke="var(--art-sun)" stroke-width="3" />
  <path class="flick" d="M160 290l4 10l10 4l-10 4l-4 10l-4 -10l-10 -4l10 -4z" fill="var(--art-sun)" />
  <text x="160" y="334" text-anchor="middle" class="t">✨ {twinkles}</text>
  <!-- planet: many rays, steady -->
  <circle cx="480" cy="40" r="11" fill="var(--art-o)" stroke="var(--art-sun)" stroke-width="2" />
  <text x="480" y="72" text-anchor="middle" class="t">{planet}</text>
  {[-12, -6, 0, 6, 12].map((dx, i) => (
    <path class="wob" style={`animation-delay:${-i * 0.3}s`} d={`M${480 + dx} 90L${480 + dx} 120L${470 + dx} 160L${488 + dx} 200L${480 + dx} 280`} fill="none" stroke="var(--art-o)" stroke-width="2" opacity="0.7" />
  ))}
  <circle cx="480" cy="304" r="10" fill="var(--art-o)" stroke="var(--art-sun)" stroke-width="2" />
  <text x="480" y="334" text-anchor="middle" class="t">● {steady}</text>
  <text x="320" y="300" text-anchor="middle" class="t">👁 {you}</text>
</Figure>

<style>
  .t {
    font-weight: 850;
    font-size: 15px;
    fill: var(--art-moon);
  }
  .air path {
    animation: drift 6s linear infinite;
  }
  .air .b {
    animation-duration: 4.5s;
    animation-direction: reverse;
  }
  .wob {
    animation: wob 1.4s ease-in-out infinite alternate;
  }
  .flick {
    animation: flick 1.1s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes drift {
    to { transform: translateX(80px); }
  }
  @keyframes wob {
    to { transform: translateX(8px) skewX(4deg); }
  }
  @keyframes flick {
    0%, 100% { transform: scale(1); opacity: 1; }
    30% { transform: scale(0.5) translateX(3px); opacity: 0.5; }
    60% { transform: scale(1.2) translateX(-2px); opacity: 1; }
  }
</style>
