---
// Inside the Sun: fusion in the core, light zigzagging slowly outward through the radiative zone, hot gas
// rolling in the convection zone, and the visible surface. Inset: four hydrogens become one helium + energy.
import Figure from '../Figure.astro';
interface Props { label: string; core: string; zigzag: string; boil: string; surface: string; fusion: string; hydrogen: string; helium: string }
const { label, core, zigzag, boil, surface, fusion, hydrogen, helium } = Astro.props;
// A random walk for the light, fixed so the picture is the same every build.
const walk = [[0, 0], [18, -10], [8, -30], [30, -38], [24, -60], [50, -58], [44, -82], [70, -90], [64, -110], [88, -116]];
---
<Figure label={label} width={640} height={340}>
  <rect width="640" height="340" rx="16" fill="var(--art-night)" />
  <g transform="translate(190 330)">
    <circle r="300" fill="var(--art-sun-2)" />
    <circle r="250" fill="var(--art-o)" />
    <circle r="160" fill="var(--art-y)" />
    <circle r="70" fill="var(--art-white)" />
    {[-150, -110, -70, -30, 10, 50].map((a) => (
      <path transform={`rotate(${a})`} d="M0 -258a22 22 0 1 1 0 -0.1" fill="none" stroke="var(--art-red)" stroke-width="3" opacity="0.7" />
    ))}
    <path transform="translate(-30 -80)" d={'M' + walk.map((p) => p.join(' ')).join('L')} fill="none" stroke="var(--art-ink)" stroke-width="2.5" stroke-dasharray="4 3" />
  </g>
  <g class="t">
    <text x="190" y="300" text-anchor="middle">{core}</text>
    <text x="186" y="200" text-anchor="middle">{zigzag}</text>
    <text x="300" y="104" text-anchor="middle">{boil}</text>
    <text x="40" y="44" class="lite">{surface}</text>
  </g>
  <!-- fusion inset -->
  <rect x="420" y="20" width="200" height="300" rx="14" fill="var(--art-white)" stroke="var(--art-ink)" stroke-width="3" />
  <text x="520" y="50" text-anchor="middle" class="h">{fusion}</text>
  {[[470, 90], [500, 90], [540, 90], [570, 90]].map(([x, y]) => <circle cx={x} cy={y} r="11" fill="var(--art-red)" stroke="var(--art-ink)" stroke-width="2" />)}
  <text x="520" y="124" text-anchor="middle" class="s">4 × {hydrogen}</text>
  <path d="M520 136v40M510 166l10 12l10 -12" fill="none" stroke="var(--art-ink)" stroke-width="3" stroke-linecap="round" />
  <g transform="translate(520 214)">
    <circle cx="-10" cy="-10" r="11" fill="var(--art-red)" stroke="var(--art-ink)" stroke-width="2" />
    <circle cx="10" cy="-10" r="11" fill="var(--art-shirt)" stroke="var(--art-ink)" stroke-width="2" />
    <circle cx="-10" cy="10" r="11" fill="var(--art-shirt)" stroke="var(--art-ink)" stroke-width="2" />
    <circle cx="10" cy="10" r="11" fill="var(--art-red)" stroke="var(--art-ink)" stroke-width="2" />
  </g>
  <text x="520" y="256" text-anchor="middle" class="s">1 × {helium}</text>
  <text x="520" y="290" text-anchor="middle" class="h">+ ⚡ ☀️</text>
</Figure>

<style>
  .t text,
  .t {
    font-weight: 850;
    font-size: 14px;
    fill: var(--art-ink);
  }
  .t .lite {
    fill: var(--art-moon);
  }
  .h {
    font-weight: 900;
    font-size: 16px;
    fill: var(--art-ink);
  }
  .s {
    font-weight: 750;
    font-size: 13px;
    fill: var(--art-ink);
  }
</style>
