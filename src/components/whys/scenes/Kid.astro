---
// The cartoon kid who appears in Whys pictures. (x, y) is the ground between the feet; about 145 units tall.
interface Props {
  x: number;
  y: number;
  s?: number;
  /** Seen from behind (looking into the picture). */
  back?: boolean;
  /** Raise the right arm to point up. */
  point?: boolean;
  mood?: 'wow' | 'smile' | 'brr';
  /** Where the eyes look, in units: [dx, dy]. */
  look?: [number, number];
  shirt?: string;
  flip?: boolean;
}
const { x, y, s = 1, back = false, point = false, mood = 'smile', look = [0, 0], shirt = 'var(--art-shirt)', flip = false } = Astro.props;
const [lx, ly] = look;
---
<g transform={`translate(${x} ${y}) scale(${flip ? -s : s} ${s})`} class="kid" stroke="var(--art-ink)" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
  <!-- legs & shoes -->
  <path d="M-11 -42v34M10 -42v34" stroke-width="11" />
  <ellipse cx="-13" cy="-4" rx="10" ry="6" fill="var(--art-ink)" />
  <ellipse cx="12" cy="-4" rx="10" ry="6" fill="var(--art-ink)" />
  <!-- body -->
  <path d="M-24 -40q-2 -38 24 -46q26 8 24 46z" fill={shirt} />
  <!-- arms -->
  <path d="M-21 -74q-14 14 -12 34" fill="none" stroke-width="9" />
  <path d="M-21 -74q-14 14 -12 34" fill="none" stroke={shirt} stroke-width="4" />
  <circle cx="-33" cy="-38" r="5.5" fill="var(--art-skin)" />
  {point ? (
    <>
      <path d="M21 -74q16 -14 24 -42" fill="none" stroke-width="9" />
      <path d="M21 -74q16 -14 24 -42" fill="none" stroke={shirt} stroke-width="4" />
      <circle cx="45" cy="-119" r="5.5" fill="var(--art-skin)" />
      <path d="M46 -124l3 -9" stroke-width="4" />
    </>
  ) : (
    <>
      <path d="M21 -74q14 14 12 34" fill="none" stroke-width="9" />
      <path d="M21 -74q14 14 12 34" fill="none" stroke={shirt} stroke-width="4" />
      <circle cx="33" cy="-38" r="5.5" fill="var(--art-skin)" />
    </>
  )}
  <!-- head -->
  <circle cx="0" cy="-112" r="27" fill="var(--art-skin)" />
  {back ? (
    <path d="M-27 -110a27 27 0 1 1 54 0q-2 18 -12 24h-30q-10 -6 -12 -24z" fill="var(--art-hair)" />
  ) : (
    <>
      <path d="M-27 -114q2 -28 30 -26q24 2 24 24q-10 -12 -26 -12q-6 8 -16 6q-6 2 -12 8z" fill="var(--art-hair)" />
      <ellipse cx={-9 + lx} cy={-110 + ly} rx="3.6" ry="4.6" fill="var(--art-ink)" stroke="none" />
      <ellipse cx={9 + lx} cy={-110 + ly} rx="3.6" ry="4.6" fill="var(--art-ink)" stroke="none" />
      <circle cx="-16" cy="-99" r="4.5" fill="var(--art-cheek)" stroke="none" opacity="0.8" />
      <circle cx="16" cy="-99" r="4.5" fill="var(--art-cheek)" stroke="none" opacity="0.8" />
      {mood === 'wow' && <ellipse cx="0" cy="-96" rx="4.5" ry="6" fill="var(--art-ink)" stroke-width="0" />}
      {mood === 'smile' && <path d="M-7 -98q7 7 14 0" fill="none" stroke-width="2.6" />}
      {mood === 'brr' && <path d="M-8 -96l4 -3l4 3l4 -3l4 3" fill="none" stroke-width="2.4" />}
    </>
  )}
</g>
