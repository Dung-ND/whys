---
// Why do volcanoes erupt? A volcano blasts ash and glowing lava into the sky; lava flows down its side, and a
// kid watches from a safe distance with binoculars.
import Kid from './Kid.astro';
---
<rect width="640" height="400" fill="var(--art-sky)" />
<g class="ash" fill="var(--art-storm)" stroke="var(--art-ink)" stroke-width="3">
  <circle cx="330" cy="90" r="40" /><circle cx="290" cy="60" r="30" /><circle cx="370" cy="54" r="34" /><circle cx="330" cy="30" r="28" />
</g>
{[[300, 120], [360, 110], [330, 100]].map(([x, y], i) => (
  <circle class="bomb" style={`animation-delay:${-i * 0.7}s`} cx={x} cy={y} r="7" fill="var(--art-o)" stroke="var(--art-ink)" stroke-width="2" />
))}
<path d="M120 340L290 140h80l170 200z" fill="var(--art-wood)" stroke="var(--art-ink)" stroke-width="4" stroke-linejoin="round" />
<path d="M290 140h80l-10 20h-60z" fill="var(--art-red)" stroke="var(--art-ink)" stroke-width="3" />
<path class="lava" d="M310 156q-10 60 -40 90t-30 90M350 156q20 50 50 80t40 100" fill="none" stroke="var(--art-o)" stroke-width="12" stroke-linecap="round" />
<path d="M0 340h640v60h-640z" fill="var(--art-grass)" stroke="var(--art-ink)" stroke-width="4" />
<Kid x={560} y={384} s={0.8} mood="wow" look={[-4, -3]} shirt="var(--art-g)" />

<style>
  .ash {
    animation: puff 4s ease-in-out infinite alternate;
    transform-origin: 330px 90px;
  }
  .bomb {
    animation: fly 2.1s ease-out infinite;
  }
  .lava {
    stroke-dasharray: 20 10;
    animation: flow 2s linear infinite;
  }
  @keyframes puff {
    to { transform: scale(1.1) translateY(-6px); }
  }
  @keyframes fly {
    from { transform: translate(0, 20px); opacity: 1; }
    to { transform: translate(30px, -60px); opacity: 0; }
  }
  @keyframes flow {
    to { stroke-dashoffset: -30; }
  }
</style>
