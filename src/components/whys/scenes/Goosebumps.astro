---
// Why do we get goosebumps? A shivering kid in the snow, and a magnifying glass on their arm:
// tiny muscles have pulled each hair upright, raising a bump around it.
import Kid from './Kid.astro';
const flakes = [[60, 40], [180, 90], [300, 30], [120, 200], [250, 160], [40, 290], [330, 240], [600, 30], [560, 330]];
---
<rect width="640" height="400" fill="var(--art-sky-2)" />
<path d="M0 320q160 -30 320 -6t320 -4v90h-640z" fill="var(--art-white)" stroke="var(--art-ink)" stroke-width="4" />
{flakes.map(([x, y], i) => (
  <g class="flake" style={`animation-delay:${-i * 0.8}s`}>
    <path transform={`translate(${x} ${y})`} d="M0 -9v18M-8 -4.5l16 9M-8 4.5l16 -9" stroke="var(--art-water)" stroke-width="3" stroke-linecap="round" />
  </g>
))}
<g class="shiver"><Kid x={170} y={372} mood="brr" look={[3, 0]} shirt="var(--art-red)" /></g>
<!-- puffs of cold breath -->
<g class="breath" fill="var(--art-white)" stroke="var(--art-ink)" stroke-width="2.5" opacity="0.9">
  <circle cx="214" cy="266" r="7" /><circle cx="230" cy="256" r="10" />
</g>
<!-- magnifier from the arm -->
<path d="M206 340L360 250" stroke="var(--art-ink)" stroke-width="3" stroke-dasharray="6 6" />
<circle cx="470" cy="190" r="140" fill="var(--art-skin)" stroke="var(--art-ink)" stroke-width="8" />
<g class="skin">
  {[[400, 150], [480, 120], [540, 180], [430, 230], [510, 250], [460, 300], [390, 80 + 140], [560, 120]].map(([x, y]) => (
    <g transform={`translate(${x} ${y})`}>
      <ellipse cx="0" cy="4" rx="17" ry="12" fill="var(--art-skin-2)" />
      <ellipse cx="-3" cy="0" rx="12" ry="8" fill="var(--art-skin)" />
      <path class="hair" d="M0 4q-3 -16 3 -34" fill="none" stroke="var(--art-hair)" stroke-width="3.5" stroke-linecap="round" />
    </g>
  ))}
</g>
<circle cx="470" cy="190" r="140" fill="none" stroke="var(--art-wood)" stroke-width="6" />
<path d="M570 290l46 46" stroke="var(--art-wood)" stroke-width="22" stroke-linecap="round" />

<style>
  .shiver {
    animation: shiver 0.18s linear infinite alternate;
  }
  .flake {
    animation: fall 6s linear infinite;
  }
  .breath {
    animation: puff 2s ease-out infinite;
    transform-box: fill-box;
    transform-origin: left bottom;
  }
  @keyframes shiver {
    to { transform: translateX(3px); }
  }
  @keyframes fall {
    from { transform: translateY(-60px); }
    to { transform: translateY(60px); }
  }
  @keyframes puff {
    from { transform: scale(0.4); opacity: 1; }
    to { transform: scale(1.3) translate(10px, -10px); opacity: 0; }
  }
</style>
