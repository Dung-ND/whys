---
// Why does ice float? An iceberg in the sea: only its tip shows; about 90% is under water.
// A penguin stands on top and fish swim below.
---
<rect width="640" height="400" fill="var(--art-sky)" />
<circle cx="90" cy="60" r="30" fill="var(--art-sun)" stroke="var(--art-ink)" stroke-width="4" />
<rect y="120" width="640" height="280" fill="var(--art-water)" />
<rect y="120" width="640" height="280" fill="var(--art-shirt)" opacity="0.25" />
<!-- the iceberg: a small tip above, a big body below (to scale: about 1 part in 10 above) -->
<g class="berg" stroke="var(--art-ink)" stroke-width="4" stroke-linejoin="round">
  <path d="M250 120l40 -38l30 18l36 -26l30 46z" fill="var(--art-white)" />
  <path d="M250 120h136l40 60l-10 90l-60 90h-120l-50 -70l10 -110z" fill="var(--art-glass)" opacity="0.92" />
</g>
<path d="M0 120q20 -6 40 0t40 0t40 0t40 0t40 0t40 0t40 0t40 0t40 0t40 0t40 0t40 0t40 0t40 0t40 0t40 0" fill="none" stroke="var(--art-white)" stroke-width="4" class="waves" />
<!-- penguin -->
<g transform="translate(318 74)" class="peng" stroke="var(--art-ink)" stroke-width="3">
  <ellipse cx="0" cy="-26" rx="16" ry="24" fill="var(--art-ink)" />
  <ellipse cx="2" cy="-20" rx="10" ry="17" fill="var(--art-white)" stroke="none" />
  <circle cx="4" cy="-40" r="2.5" fill="var(--art-white)" stroke="none" />
  <path d="M12 -38l10 3l-10 3z" fill="var(--art-o)" stroke-width="2" />
  <path d="M-8 0h8M2 0h8" stroke="var(--art-o)" stroke-width="4" />
</g>
<!-- fish -->
{[[110, 260, 1], [530, 320, -1], [560, 200, -1]].map(([x, y, d], i) => (
  <g transform={`translate(${x} ${y}) scale(${d} 1)`}>
    <g class="fish" style={`animation-delay:${-i * 1.3}s`} stroke="var(--art-ink)" stroke-width="2.5">
      <path d="M-22 0l-12 -10v20z" fill="var(--art-o)" />
      <ellipse cx="0" cy="0" rx="22" ry="12" fill="var(--art-o)" />
      <circle cx="10" cy="-3" r="2.5" fill="var(--art-ink)" stroke="none" />
    </g>
  </g>
))}

<style>
  .berg {
    animation: bob 5s ease-in-out infinite;
  }
  .peng {
    animation: bob 5s ease-in-out infinite;
  }
  .waves {
    animation: wave 4s ease-in-out infinite alternate;
  }
  .fish {
    animation: swim 4s ease-in-out infinite;
  }
  @keyframes bob {
    50% { transform: translateY(4px); }
  }
  @keyframes wave {
    to { transform: translateX(-20px); }
  }
  @keyframes swim {
    50% { transform: translate(24px, -6px); }
  }
</style>
