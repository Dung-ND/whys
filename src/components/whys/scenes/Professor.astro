---
// Professor Owl, in safety goggles, studying a question mark. Drawn on 480 × 400.
---
<g class="prof">
  <circle cx="250" cy="200" r="180" fill="var(--art-sky-2)" />
  <!-- graph paper in the circle -->
  <g stroke="var(--art-shirt)" stroke-width="1" opacity="0.15">
    {Array.from({ length: 13 }, (_, i) => <path d={`M${80 + i * 28} 40v320M70 ${50 + i * 26}h360`} />)}
  </g>

  <!-- flask with bubbles -->
  <g class="flask" stroke="var(--art-ink)" stroke-width="4" stroke-linejoin="round">
    <path d="M86 230h36v40l34 64q6 14 -10 14h-84q-16 0 -10 -14l34 -64z" fill="var(--art-glass)" />
    <path d="M70 312q20 -8 34 0t38 0l8 18q4 10 -8 10h-82q-12 0 -8 -10z" fill="var(--art-leaf)" stroke="none" />
    <path d="M80 230h48" />
    <circle class="b b1" cx="98" cy="300" r="6" fill="var(--art-leaf)" />
    <circle class="b b2" cx="112" cy="310" r="4" fill="var(--art-leaf)" />
    <circle class="b b3" cx="104" cy="315" r="5" fill="var(--art-leaf)" />
  </g>

  <!-- Professor Owl -->
  <g class="owl" stroke="var(--art-ink)" stroke-linejoin="round">
    <path d="M286 334l-8 12h20zM334 334l-8 12h20z" fill="var(--art-o)" stroke-width="3.5" />
    <path d="M252 104l-14 -44l42 30zM368 104l14 -44l-42 30z" fill="var(--art-wood)" stroke-width="5" />
    <path d="M310 82c74 0 94 70 94 140c0 74 -40 114 -94 114s-94 -40 -94 -114c0 -70 20 -140 94 -140z" fill="var(--art-wood)" stroke-width="5" />
    <ellipse cx="310" cy="256" rx="60" ry="66" fill="var(--art-tan)" stroke="none" />
    <g fill="none" stroke="var(--art-wood)" stroke-width="3.5" stroke-linecap="round">
      <path d="M284 236l8 8l8 -8M320 236l8 8l8 -8M300 266l8 8l8 -8M284 296l8 8l8 -8M320 296l8 8l8 -8" />
    </g>
    <!-- right wing, tucked -->
    <path d="M396 196q22 50 -6 104q-22 -40 -14 -96z" fill="var(--art-horse)" stroke-width="4.5" />
    <!-- goggles -->
    <path d="M226 160h168" stroke="var(--art-ink)" stroke-width="7" />
    <circle cx="276" cy="164" r="38" fill="var(--art-white)" stroke="var(--art-shirt)" stroke-width="9" />
    <circle cx="344" cy="164" r="38" fill="var(--art-white)" stroke="var(--art-shirt)" stroke-width="9" />
    <g class="eyes">
      <circle cx="282" cy="168" r="14" fill="var(--art-ink)" stroke="none" />
      <circle cx="350" cy="168" r="14" fill="var(--art-ink)" stroke="none" />
      <circle cx="287" cy="162" r="4.5" fill="var(--art-white)" stroke="none" />
      <circle cx="355" cy="162" r="4.5" fill="var(--art-white)" stroke="none" />
    </g>
    <path d="M298 196h24l-12 22z" fill="var(--art-o)" stroke-width="3.5" />
    <!-- left wing, holding the magnifying glass -->
    <path d="M226 200q-30 -8 -24 10q14 26 34 30z" fill="var(--art-horse)" stroke-width="4.5" />
  </g>
  <g class="glass">
    <path d="M206 200l-26 -26" stroke="var(--art-wood)" stroke-width="12" stroke-linecap="round" />
    <circle cx="160" cy="152" r="40" fill="var(--art-glass)" fill-opacity="0.7" stroke="var(--art-ink)" stroke-width="7" />
    <text x="160" y="172" text-anchor="middle" class="q">?</text>
  </g>
  <!-- sparkles -->
  <path class="sp sp1" d="M408 96l5 13l13 5l-13 5l-5 13l-5 -13l-13 -5l13 -5z" fill="var(--art-sun)" stroke="var(--art-ink)" stroke-width="2.5" />
  <path class="sp sp2" d="M120 76l4 9l9 4l-9 4l-4 9l-4 -9l-9 -4l9 -4z" fill="var(--art-sun)" stroke="var(--art-ink)" stroke-width="2.5" />
</g>

<style>
  .q {
    font-weight: 900;
    font-size: 64px;
    fill: var(--art-ink);
  }
  .owl {
    animation: bob 3.2s ease-in-out infinite;
  }
  .eyes {
    animation: blink 5s infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes blink {
    0%, 94%, 100% { transform: none; }
    97% { transform: scaleY(0.1); }
  }
  .glass {
    animation: peer 3.2s ease-in-out infinite;
    transform-box: view-box;
    transform-origin: 206px 200px;
  }
  .b {
    animation: rise 2.4s ease-in infinite;
  }
  .b2 { animation-delay: 0.8s; }
  .b3 { animation-delay: 1.6s; }
  .sp {
    animation: twinkle 2s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  .sp2 { animation-delay: 1s; }
  @keyframes bob {
    50% { transform: translateY(-6px) rotate(-1.5deg); }
  }
  @keyframes peer {
    50% { transform: rotate(-6deg) translate(-4px, -2px); }
  }
  @keyframes rise {
    from { transform: translateY(0); opacity: 1; }
    to { transform: translateY(-110px); opacity: 0; }
  }
  @keyframes twinkle {
    50% { transform: scale(0.6) rotate(45deg); }
  }
</style>
