---
// Wraps a moving picture: it plays by itself, pauses off screen, and has a play/pause button.
// The pause is site-wide (src/lib/motion.ts); pausing freezes every CSS animation inside.
import { useT, langFromUrl } from '@/i18n';
const t = useT(langFromUrl(Astro.url));
---
<div class="anim" data-anim>
  <slot />
  <button type="button" class="pp" data-pp data-pause={t('motion.pause')} data-play={t('motion.play')} aria-label={t('motion.pause')} title={t('motion.pause')}>
    <svg class="i-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1.5" /><rect x="14" y="5" width="4" height="14" rx="1.5" /></svg>
    <svg class="i-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.9l10.2-6.5a1 1 0 0 0 0-1.8L9.5 4.6A1 1 0 0 0 8 5.5z" /></svg>
  </button>
</div>

<script>
  import { onMotion, onVisible, setMotion, motionOn } from '@/lib/motion';
  document.querySelectorAll<HTMLElement>('.anim[data-anim]').forEach((box) => {
    const btn = box.querySelector<HTMLButtonElement>('[data-pp]')!;
    onVisible(box, (v) => box.toggleAttribute('data-offscreen', !v));
    onMotion((on) => {
      box.toggleAttribute('data-paused', !on);
      const label = on ? btn.dataset.pause! : btn.dataset.play!;
      btn.setAttribute('aria-label', label);
      btn.title = label;
    });
    btn.addEventListener('click', () => setMotion(!motionOn()));
  });
</script>

<style>
  .anim {
    position: relative;
  }
  .pp {
    position: absolute;
    left: 10px;
    bottom: 10px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid var(--art-ink);
    background: var(--art-white);
    color: var(--art-ink);
    cursor: pointer;
    opacity: 0.85;
    box-shadow: var(--shadow-1);
    transition: opacity var(--t-fast), transform var(--t-fast);
  }
  .pp:hover {
    opacity: 1;
    transform: scale(1.06);
  }
  .pp svg {
    fill: currentColor;
  }
  .i-play,
  [data-paused] > .pp .i-pause {
    display: none;
  }
  [data-paused] > .pp .i-play {
    display: block;
  }
</style>
