---
import Base from '@/layouts/Base.astro';
import WhyCard from '@/components/whys/WhyCard.astro';
import Scene from '@/components/whys/scenes/Scene.astro';
import Animated from '@/components/whys/Animated.astro';
import { render } from 'astro:content';
import { useT, href } from '@/i18n';
import { locales, defaultLang, type Lang } from '@/config/site';
import { whyCategories, whyNumber, localized } from '@/data/whys';
import { loadWhys, catStyle, type LoadedWhy } from '@/components/whys/load';

export async function getStaticPaths() {
  const all = await Promise.all(locales.map(async (lang) => ({ lang, items: await loadWhys(lang) })));
  return all.flatMap(({ lang, items }) =>
    items.map((item, i) => ({
      params: { lang: lang === defaultLang ? undefined : lang, slug: item.why.slug },
      // "More whys": the same category first, then the ones that come next.
      props: {
        lang,
        item,
        more: [...items.slice(i + 1), ...items.slice(0, i)]
          .sort((a, b) => Number(b.why.category === item.why.category) - Number(a.why.category === item.why.category))
          .slice(0, 3),
      },
    })),
  );
}

const { lang, item, more } = Astro.props as { lang: Lang; item: LoadedWhy; more: LoadedWhy[] };
const { why, entry, fallback } = item;
const { Content } = await render(entry);
const t = useT(lang);
const cat = whyCategories[why.category];
---

<Base lang={lang} title={entry.data.question} description={entry.data.teaser}>
  <article class="why" style={catStyle(why)}>
    <header class="wrap head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={href(lang)}>{t('whys.title')}</a>
        <span aria-hidden="true">/</span>
        <a href={href(lang, `?cat=${why.category}`)}>{localized(cat.title, lang)}</a>
      </nav>
      <div class="meta">
        <span class="num">{t('whys.number', { n: whyNumber(why.n) })}</span>
        <span class="chip cat">{localized(cat.title, lang)}</span>
        <span class="chip">⏱ {t('common.minutes', { n: why.minutes })}</span>
      </div>
      <h1>{entry.data.question}</h1>
      <p class="lead">{entry.data.teaser}</p>
      {fallback && <p class="notice">{t('whys.translationMissing')}</p>}
    </header>

    <div class="wrap content">
      <div class="hero"><Animated><Scene slug={why.slug} label={entry.data.art} /></Animated></div>
    </div>

    <div class="wrap content">
      <Content lang={lang} />
    </div>

    <footer class="wrap more">
      <h2>{t('whys.more')}</h2>
      <div class="grid">{more.map((m) => <WhyCard item={m} lang={lang} />)}</div>
      <p class="all"><a class="btn btn-ghost" href={href(lang)}>← {t('whys.back')}</a></p>
    </footer>
  </article>
</Base>

<style>
  .head {
    padding: 2.5rem 0 1.5rem;
    max-width: 980px;
  }
  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: var(--fs-0);
    font-weight: 750;
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .crumbs a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .num {
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: var(--fs-0);
    padding: 0.15em 0.6em;
    border-radius: 6px;
    background: var(--ink);
    color: var(--bg);
  }
  .chip.cat {
    background: var(--cat-soft);
    color: var(--cat-text);
    border-color: transparent;
  }
  h1 {
    font-size: clamp(2.3rem, 6vw, 4rem);
    letter-spacing: -0.04em;
    margin: 0.75rem 0 0.5rem;
  }
  .lead {
    font-size: var(--fs-3);
    color: var(--ink-2);
    max-width: 34em;
  }
  .notice {
    background: var(--brand-soft);
    padding: 0.6rem 1rem;
    border-radius: var(--r-1);
    font-size: var(--fs-0);
    font-weight: 700;
  }
  .hero {
    max-width: 980px;
    border-radius: var(--r-3);
    overflow: hidden;
    box-shadow: var(--shadow-2);
    border: 4px solid var(--cat);
  }
  .content {
    max-width: 980px;
  }
  .more {
    max-width: 980px;
  }
  .more h2 {
    font-size: var(--fs-4);
    margin: 3rem 0 1rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  .all {
    margin-top: 2rem;
  }
</style>
