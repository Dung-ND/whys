---
// "Coming soon": questions not written yet (src/data/ideas.ts), for readers and for contributors.
import Base from '@/layouts/Base.astro';
import { langPaths, useT, href } from '@/i18n';
import { site, defaultLang, type Lang } from '@/config/site';
import { ideas } from '@/data/ideas';
import { whyCategories, localized, type WhyCategory } from '@/data/whys';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const cats = Object.keys(whyCategories) as WhyCategory[];
const guide = `${site.repo}/blob/main/CONTRIBUTING.md`;
---

<Base lang={lang} title={t('ideas.title')} description={t('ideas.lead', { n: ideas.length })}>
  <section class="wrap head">
    <nav class="crumbs" aria-label="Breadcrumb"><a href={href(lang)}>{t('whys.title')}</a></nav>
    <h1>{t('ideas.title')}</h1>
    <p class="lead">{t('ideas.lead', { n: ideas.length })}</p>
    <p class="help">🧪 {t('ideas.help')} <a href={guide}>{t('ideas.guide')} →</a></p>
    {lang !== defaultLang && <p class="note">{t('ideas.englishOnly')}</p>}
  </section>

  <section class="wrap list">
    {cats.map((c) => {
      const list = ideas.filter((i) => i.category === c);
      if (!list.length) return null;
      return (
        <section class="cat" style={`--cat:${whyCategories[c].color};--cat-text:${whyCategories[c].text}`}>
          <h2><span class="dot" aria-hidden="true"></span>{localized(whyCategories[c].title, lang)} <span class="n">{list.length}</span></h2>
          <ul>
            {list.map((i) => (
              <li class={i.status}>
                <span class="q" lang="en">{i.question}</span>
                <span class="hint" lang="en">{i.hint}</span>
                <span class="meta">
                  <span class="badge">{i.status === 'started' ? t('ideas.started', { name: i.by ?? '?' }) : t('ideas.open')}</span>
                  <code>{i.slug}</code>
                </span>
              </li>
            ))}
          </ul>
        </section>
      );
    })}
  </section>
</Base>

<style>
  .head {
    padding: 2.5rem 0 1rem;
    max-width: 980px;
  }
  .crumbs {
    font-size: var(--fs-0);
    font-weight: 750;
    margin-bottom: 1rem;
  }
  .crumbs a {
    color: var(--ink-2);
    text-decoration: none;
  }
  h1 {
    font-size: clamp(2.3rem, 6vw, 4rem);
    letter-spacing: -0.04em;
    margin: 0 0 0.5rem;
  }
  .lead {
    font-size: var(--fs-3);
    color: var(--ink-2);
  }
  .help {
    padding: 0.8rem 1.1rem;
    border-radius: var(--r-2);
    background: var(--brand-soft);
    font-weight: 700;
  }
  .note {
    font-size: var(--fs-0);
    color: var(--muted);
  }
  .list {
    max-width: 980px;
  }
  .cat {
    margin: 2.5rem 0;
  }
  h2 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--fs-4);
  }
  h2 .dot {
    width: 0.7em;
    height: 0.7em;
    background: var(--cat);
  }
  h2 .n {
    font-size: var(--fs-0);
    font-family: var(--font-mono);
    color: var(--muted);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 0.75rem;
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.9rem 1rem;
    border-radius: var(--r-2);
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 4px solid var(--cat);
  }
  .q {
    font-weight: 850;
    font-size: var(--fs-2);
    line-height: 1.3;
  }
  .hint {
    font-size: var(--fs-0);
    color: var(--ink-2);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.2rem;
  }
  .badge {
    font-size: 0.75rem;
    font-weight: 850;
    padding: 0.1em 0.6em;
    border-radius: var(--r-pill);
    background: var(--ok-soft);
    color: var(--ink);
  }
  .started .badge {
    background: var(--warn-soft);
  }
  code {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
</style>
