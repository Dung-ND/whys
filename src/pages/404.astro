---
import Base from '@/layouts/Base.astro';
import { useT, href } from '@/i18n';
import { defaultLang } from '@/config/site';
const t = useT(defaultLang);
---
<Base lang={defaultLang} title={t('404.title')}>
  <section class="wrap nf">
    <svg viewBox="0 0 200 200" width="180" height="180" aria-hidden="true">
      <circle cx="100" cy="100" r="60" fill="var(--brand)" />
      <ellipse cx="100" cy="100" rx="95" ry="22" fill="none" stroke="var(--c-purple)" stroke-width="6" transform="rotate(-18 100 100)" />
      <circle cx="80" cy="85" r="7" fill="var(--ink)" /><circle cx="120" cy="85" r="7" fill="var(--ink)" />
      <path d="M85 120 q15 -12 30 0" fill="none" stroke="var(--ink)" stroke-width="5" stroke-linecap="round" />
    </svg>
    <h1>{t('404.title')}</h1>
    <p>{t('404.lead')}</p>
    <a class="btn btn-primary" href={href(defaultLang)}>{t('404.home')}</a>
  </section>
</Base>
<style>
  .nf {
    text-align: center;
    padding: 5rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  h1 {
    font-size: var(--fs-5);
    margin-top: 1rem;
  }
</style>
